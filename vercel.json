{
  "version": 2,
  "builds": [
    {
      "src": "FrontEnd/dinemaster-app/package.json",
      "use": "@vercel/static-build"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "FrontEnd/dinemaster-app/$1",
      "check": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "FrontEnd/dinemaster-app/index.html"
    }
  ]
}
